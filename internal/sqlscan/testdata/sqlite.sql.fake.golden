CREATE TABLE IF NOT EXISTS "orders" ("id" integer primary key autoincrement not null, "user_id" integer not null, "number" varchar not null, "status" varchar check ("status" in ('pending', 'paid', 'refunded')) not null default 'pending', "total" numeric not null, "billing_name" varchar not null, "billing_email" varchar not null, "billing_phone" varchar, "shipping_address" text, "shipping_postcode" varchar, "card_last4" varchar, "payment_intent" varchar, "notes" text, "meta" text, "created_at" datetime, "updated_at" datetime, foreign key("user_id") references "users"("id") on delete cascade);
